generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  company       String?
  linkedinUrl   String?
  createdAt     DateTime  @default(now())

  // Every account starts with a full-access trial. Null means the trial was
  // never granted (only possible for rows created before billing existed).
  trialEndsAt   DateTime?

  // Once the trial lapses an unpaid user keeps exactly one tool. Null means
  // they have not picked yet, which the app treats as "must choose".
  freeTool          String?
  freeToolChangedAt DateTime?

  // Lives on the user rather than on Subscription because a customer outlives
  // any individual subscription: cancel, resubscribe, and it is still them.
  paddleCustomerId String? @unique

  // When the user last looked at their finished results. Anything that
  // completed after this is what the header badge counts, which needs one
  // column rather than a read flag on every row of every tool.
  resultsSeenAt DateTime?

  // owner | admin | user. Owner is the only role that can change roles, and
  // the last owner cannot be demoted, so the app can never be locked out of
  // its own admin area.
  role String @default("user")

  accounts       Account[]
  sessions       Session[]
  sites          Site[]
  keywordSearches KeywordSearch[]
  contentGrades  ContentGrade[]
  localListings  LocalListing[]
  pageSpeedChecks PageSpeedCheck[]
  searchConsoleReports SearchConsoleReport[]
  subscription   Subscription?
  feedback       Feedback[]
  monitors       Monitor[]
  alertRecipients AlertRecipient[]
}

/**
 * A URL we keep an eye on.
 *
 * consecutiveFailures is the whole reason this is trustworthy: a single failed
 * request means almost nothing, since networks blip. Only after several in a
 * row do we say a site is down, which is the difference between a useful alert
 * and one people learn to ignore.
 */
model Monitor {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId String?

  url             String
  enabled         Boolean @default(true)
  intervalMinutes Int     @default(5)

  // unknown until the first check completes.
  status              String    @default("unknown") // unknown | up | down
  consecutiveFailures Int       @default(0)
  lastCheckedAt       DateTime?
  lastChangedAt       DateTime?
  lastStatusCode      Int?
  lastResponseMs      Int?
  lastError           String?

  createdAt  DateTime         @default(now())
  events     AlertEvent[]
  recipients AlertRecipient[]

  @@unique([userId, url])
  @@index([enabled, lastCheckedAt])
}

/** Who hears about it. */
/// Who hears about one specific site going down.
///
/// Scoped to a monitor rather than to the account: somebody who looks after
/// the shop site should not be woken up about the client site next door.
/// The same person watching three sites is three rows, which is the cost of
/// keeping "who gets told about this site" answerable by looking at one place.
model AlertRecipient {
  id      String  @id @default(cuid())
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String

  name  String?
  email String

  emailEnabled Boolean @default(true)

  createdAt DateTime @default(now())

  // Adding the same address twice would just send two identical emails.
  @@unique([monitorId, email])
  @@index([userId])
  @@index([monitorId])
}

/** What happened and who was told, so an alert is never a mystery later. */
model AlertEvent {
  id        String  @id @default(cuid())
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String

  kind       String // down | recovered
  statusCode Int?
  error      String?
  /** Minutes of downtime, on a recovery event. */
  downtimeMinutes Int?

  notified  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([monitorId, createdAt])
}

model Feedback {
  id     String @id @default(cuid())
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  kind    String // bug | confusing | idea | praise
  message String

  // Captured automatically. The difference between "it didn't work" and
  // something actionable is knowing where they were and what they could see.
  pageUrl   String?
  plan      String?
  userAgent String?
  viewport  String?

  status    String   @default("new") // new | triaged | done
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model Subscription {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  paddleSubscriptionId String? @unique
  paddlePriceId        String?

  plan     String // starter | pro | agency | lifetime
  status   String // active | trialing | past_due | canceled | incomplete | unpaid
  interval String? // month | year | once

  // Null for lifetime, which never renews and so never lapses.
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  rootUrl   String
  name      String?
  createdAt DateTime @default(now())
  audits    Audit[]
  keywordSearches KeywordSearch[]
  contentGrades   ContentGrade[]
  localListings   LocalListing[]
  pageSpeedChecks PageSpeedCheck[]
  searchConsoleReports SearchConsoleReport[]
  monitors        Monitor[]

  @@unique([userId, rootUrl])
}

model Audit {
  id            String    @id @default(cuid())
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId        String
  status        String    @default("running") // running | completed | failed
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  pageLimit     Int       @default(50)
  pagesCrawled  Int       @default(0)
  healthScore   Int?
  errorMessage  String?

  // A crawl is too slow to finish inside one serverless invocation, so it runs
  // in chunks and parks its progress here between them: the queue still to
  // visit, what it has already seen, and the pages gathered so far. Cleared
  // once the audit finishes.
  crawlState    String?
  // How many chunks this audit has used. A runaway continuation loop would be
  // expensive and invisible, so it is capped.
  chunkCount    Int      @default(0)

  pages         Page[]
  issues        Issue[]
}

model Page {
  id              String   @id @default(cuid())
  audit           Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId         String
  url             String
  statusCode      Int?
  title           String?
  metaDescription String?
  h1Count         Int      @default(0)
  wordCount       Int      @default(0)
  sizeBytes       Int      @default(0)
  loadTimeMs      Int      @default(0)
  canonical       String?
  redirectedFrom  String?
  crawledAt       DateTime @default(now())
  issues          Issue[]
}

model Issue {
  id          String    @id @default(cuid())
  audit       Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId     String
  page        Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String?
  type        String
  severity    String // critical | warning | info
  category    String // technical | content | meta | links | performance
  title       String
  description String
  fixSteps    String
  affectedUrl String?
  status      String    @default("open") // open | resolved | ignored
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model KeywordSearch {
  id        String        @id @default(cuid())
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  site      Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId    String?
  seed      String
  status    String        @default("running") // running | completed | failed
  createdAt DateTime      @default(now())
  ideas     KeywordIdea[]
}

model KeywordIdea {
  id       String        @id @default(cuid())
  search   KeywordSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId String
  phrase   String
  category String // question | comparison | alphabetical
  saved    Boolean       @default(false)
}

model ContentGrade {
  id            String   @id @default(cuid())
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  site          Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId        String?
  url           String
  targetKeyword String
  status        String   @default("running") // running | completed | failed
  errorMessage  String?
  score         Int?
  wordCount     Int?
  checksJson    String? // JSON-serialized GradeCheck[]
  createdAt     DateTime @default(now())
}

model LocalListing {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?
  site         Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId       String?
  websiteUrl   String
  businessName String
  address      String
  phone        String
  reviewCount  Int?
  reviewRating Float?
  claimed      String? // yes | no | unsure
  status       String   @default("running") // running | completed | failed
  errorMessage String?
  score        Int?
  checksJson   String? // JSON-serialized ListingCheck[]
  createdAt    DateTime @default(now())
}

model PageSpeedCheck {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?
  site         Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId       String?
  url          String
  status       String   @default("running") // running | completed | failed
  errorMessage String?
  mobileScore  Int?
  desktopScore Int?
  mobileJson   String? // JSON-serialized PageSpeedStrategyResult
  desktopJson  String? // JSON-serialized PageSpeedStrategyResult
  createdAt    DateTime @default(now())
}

model SearchConsoleReport {
  id               String   @id @default(cuid())
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String?
  site             Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId           String?
  propertyUrl      String // e.g. "sc-domain:example.com" or "https://example.com/"
  status           String   @default("running") // running | completed | failed
  errorMessage     String?
  totalClicks      Int?
  totalImpressions Int?
  avgPosition      Float?
  queriesJson      String? // JSON-serialized SearchQueryRow[]
  pagesJson        String? // JSON-serialized SearchPageRow[]
  createdAt        DateTime @default(now())
}
