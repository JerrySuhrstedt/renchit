generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  company       String?
  linkedinUrl   String?
  createdAt     DateTime  @default(now())

  // Every account starts with a full-access trial. Null means the trial was
  // never granted (only possible for rows created before billing existed).
  trialEndsAt   DateTime?

  // Once the trial lapses an unpaid user keeps exactly one tool. Null means
  // they have not picked yet, which the app treats as "must choose".
  freeTool          String?
  freeToolChangedAt DateTime?

  // Lives on the user rather than on Subscription because a customer outlives
  // any individual subscription: cancel, resubscribe, and it is still them.
  stripeCustomerId String? @unique

  accounts       Account[]
  sessions       Session[]
  sites          Site[]
  keywordSearches KeywordSearch[]
  contentGrades  ContentGrade[]
  localListings  LocalListing[]
  pageSpeedChecks PageSpeedCheck[]
  searchConsoleReports SearchConsoleReport[]
  subscription   Subscription?
}

model Subscription {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  stripeSubscriptionId String? @unique
  stripePriceId        String?

  plan     String // starter | pro | agency | lifetime
  status   String // active | trialing | past_due | canceled | incomplete | unpaid
  interval String? // month | year | once

  // Null for lifetime, which never renews and so never lapses.
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  rootUrl   String
  name      String?
  createdAt DateTime @default(now())
  audits    Audit[]
  keywordSearches KeywordSearch[]
  contentGrades   ContentGrade[]
  localListings   LocalListing[]
  pageSpeedChecks PageSpeedCheck[]
  searchConsoleReports SearchConsoleReport[]

  @@unique([userId, rootUrl])
}

model Audit {
  id            String    @id @default(cuid())
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId        String
  status        String    @default("running") // running | completed | failed
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  pageLimit     Int       @default(50)
  pagesCrawled  Int       @default(0)
  healthScore   Int?
  errorMessage  String?
  pages         Page[]
  issues        Issue[]
}

model Page {
  id              String   @id @default(cuid())
  audit           Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId         String
  url             String
  statusCode      Int?
  title           String?
  metaDescription String?
  h1Count         Int      @default(0)
  wordCount       Int      @default(0)
  sizeBytes       Int      @default(0)
  loadTimeMs      Int      @default(0)
  canonical       String?
  redirectedFrom  String?
  crawledAt       DateTime @default(now())
  issues          Issue[]
}

model Issue {
  id          String    @id @default(cuid())
  audit       Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId     String
  page        Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String?
  type        String
  severity    String // critical | warning | info
  category    String // technical | content | meta | links | performance
  title       String
  description String
  fixSteps    String
  affectedUrl String?
  status      String    @default("open") // open | resolved | ignored
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model KeywordSearch {
  id        String        @id @default(cuid())
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  site      Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId    String?
  seed      String
  status    String        @default("running") // running | completed | failed
  createdAt DateTime      @default(now())
  ideas     KeywordIdea[]
}

model KeywordIdea {
  id       String        @id @default(cuid())
  search   KeywordSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  searchId String
  phrase   String
  category String // question | comparison | alphabetical
  saved    Boolean       @default(false)
}

model ContentGrade {
  id            String   @id @default(cuid())
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  site          Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId        String?
  url           String
  targetKeyword String
  status        String   @default("running") // running | completed | failed
  errorMessage  String?
  score         Int?
  wordCount     Int?
  checksJson    String? // JSON-serialized GradeCheck[]
  createdAt     DateTime @default(now())
}

model LocalListing {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?
  site         Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId       String?
  websiteUrl   String
  businessName String
  address      String
  phone        String
  reviewCount  Int?
  reviewRating Float?
  claimed      String? // yes | no | unsure
  status       String   @default("running") // running | completed | failed
  errorMessage String?
  score        Int?
  checksJson   String? // JSON-serialized ListingCheck[]
  createdAt    DateTime @default(now())
}

model PageSpeedCheck {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?
  site         Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId       String?
  url          String
  status       String   @default("running") // running | completed | failed
  errorMessage String?
  mobileScore  Int?
  desktopScore Int?
  mobileJson   String? // JSON-serialized PageSpeedStrategyResult
  desktopJson  String? // JSON-serialized PageSpeedStrategyResult
  createdAt    DateTime @default(now())
}

model SearchConsoleReport {
  id               String   @id @default(cuid())
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String?
  site             Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId           String?
  propertyUrl      String // e.g. "sc-domain:example.com" or "https://example.com/"
  status           String   @default("running") // running | completed | failed
  errorMessage     String?
  totalClicks      Int?
  totalImpressions Int?
  avgPosition      Float?
  queriesJson      String? // JSON-serialized SearchQueryRow[]
  pagesJson        String? // JSON-serialized SearchPageRow[]
  createdAt        DateTime @default(now())
}
